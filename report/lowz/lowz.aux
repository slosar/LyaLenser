\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Linear biases of the twelve tracer slices from their large-scale auto-spectra (NaMaster cross-spectrum of two random halves, $40\le \ell \le 0.2\chi $) and from the cross-spectra with the ACT DR6 and Planck PR4 lensing maps (\texttt  {report/stageb/cmb\_bias\_check\{,\_planck\}.json}). The DESI clustering analyses quote $b\simeq 1.9$--$2.3$ for the LRGs, $1.3$--$1.4$ for the ELGs, $b_{\rm  QSO}(z)=0.278[(1+z)^2-6.565]+2.393$ for the quasars and $\simeq 1.5$ for the BGS; BOSS quotes $\simeq 2$ for LOWZ and CMASS.}}{8}{table.1}\protected@file@percent }
\newlabel{tab:bias}{{1}{8}{Linear biases of the twelve tracer slices from their large-scale auto-spectra (NaMaster cross-spectrum of two random halves, $40\le \ell \le 0.2\chi $) and from the cross-spectra with the ACT DR6 and Planck PR4 lensing maps (\texttt {report/stageb/cmb\_bias\_check\{,\_planck\}.json}). The DESI clustering analyses quote $b\simeq 1.9$--$2.3$ for the LRGs, $1.3$--$1.4$ for the ELGs, $b_{\rm QSO}(z)=0.278[(1+z)^2-6.565]+2.393$ for the quasars and $\simeq 1.5$ for the BGS; BOSS quotes $\simeq 2$ for LOWZ and CMASS}{table.1}{}}
