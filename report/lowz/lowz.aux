\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces DR1 forest correlation from $1.8\times 10^8$ pixels. Left: measured $r_\perp ^2\xi _F$ in three radial-separation strips (points, pair-weight errors) with the fitted table of Equation~\eqref  {eq:xifit} (solid) and the two-parameter Kaiser fit of the same counts and basis (dotted). Middle and right: the residual of each fit in units of the per-cell error, on the $(r_\perp ,r_\parallel )$ plane used by the kernel. The two-parameter fit is systematically high at $1<r_\parallel <5\,h^{-1}{\rm  Mpc}$, where most of the lensing information is, and low by up to a factor 1.6 in the first radial bin; $\chi ^2$ over the 810 fitted cells falls from 1880 to 235.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:xi}{{2}{5}{DR1 forest correlation from $1.8\times 10^8$ pixels. Left: measured $r_\perp ^2\xi _F$ in three radial-separation strips (points, pair-weight errors) with the fitted table of Equation~\eqref {eq:xifit} (solid) and the two-parameter Kaiser fit of the same counts and basis (dotted). Middle and right: the residual of each fit in units of the per-cell error, on the $(r_\perp ,r_\parallel )$ plane used by the kernel. The two-parameter fit is systematically high at $1<r_\parallel <5\Mpch $, where most of the lensing information is, and low by up to a factor 1.6 in the first radial bin; $\chi ^2$ over the 810 fitted cells falls from 1880 to 235}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Templates from low-redshift tracers}{5}{subsection.3.3}\protected@file@percent }
\newlabel{sec:templates}{{3.3}{5}{Templates from low-redshift tracers}{subsection.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces What the correction does. Left: the excess of the first radial bin over the two-parameter fit (points) and the fitted same-wavelength term $N(r_\perp )$ (line); it is flat at $\simeq 10^{-3}$ beyond $6\,h^{-1}{\rm  Mpc}$ and enters the mean field but not the kernel. Middle: the ratio of the new response kernel to the one used in the first measurement, over the part of the pair domain where the kernel is large, with contours of the Fisher-information density of the amplitude. Right: the kernel itself, $-r_\perp ^2\,\partial \xi _F/\partial r_\perp $, at two radial separations, published (dotted) against corrected (solid). Fisher-weighted, the kernel change raises the lensing amplitude by 10 per cent.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:xicorr}{{3}{6}{What the correction does. Left: the excess of the first radial bin over the two-parameter fit (points) and the fitted same-wavelength term $N(r_\perp )$ (line); it is flat at $\simeq 10^{-3}$ beyond $6\Mpch $ and enters the mean field but not the kernel. Middle: the ratio of the new response kernel to the one used in the first measurement, over the part of the pair domain where the kernel is large, with contours of the Fisher-information density of the amplitude. Right: the kernel itself, $-r_\perp ^2\,\partial \xi _F/\partial r_\perp $, at two radial separations, published (dotted) against corrected (solid). Fisher-weighted, the kernel change raises the lensing amplitude by 10 per cent}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Where the lensing information lives: the cumulative Fisher information of the amplitude versus $r_\perp $ and $r_\parallel $ on a scale-1 mock, per band and combined. Half of the information is inside $r_\perp =15\,h^{-1}{\rm  Mpc}$ and 80 per cent at $r_\parallel <5\,h^{-1}{\rm  Mpc}$.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:profile}{{4}{6}{Where the lensing information lives: the cumulative Fisher information of the amplitude versus $r_\perp $ and $r_\parallel $ on a scale-1 mock, per band and combined. Half of the information is inside $r_\perp =15\Mpch $ and 80 per cent at $r_\parallel <5\Mpch $}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Angular power spectra of the twelve tracer maps in convergence units for unit bias: the NaMaster cross-spectrum of two random halves (points, no shot noise), the fitted $b^2C_\ell $ through the bandpower windows (line) and the shot noise measured from the half difference (dashed). The shaded band is the fit range $40\le \ell \le 0.2\chi (z_{\rm  mid})$.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:spectra}{{5}{7}{Angular power spectra of the twelve tracer maps in convergence units for unit bias: the NaMaster cross-spectrum of two random halves (points, no shot noise), the fitted $b^2C_\ell $ through the bandpower windows (line) and the shot noise measured from the half difference (dashed). The shaded band is the fit range $40\le \ell \le 0.2\chi (z_{\rm mid})$}{figure.5}{}}
