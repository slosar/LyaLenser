\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces DR1 forest correlation from $2.8\times 10^8$ pixels. Left: measured $r_\perp ^2\xi _F$ in three radial-separation strips (points, pair-weight errors, collapsed over redshift with the pair weights) with the fitted table of Equation~\eqref  {eq:xifit} (solid) and its base model without the correction (dotted), both averaged over the redshift bins with the same pair weights. Middle and right: the residual of each fit in units of the per-cell error, on the $(r_\perp ,r_\parallel )$ plane; the first three radial cells are outside the fit range.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:xi}{{2}{5}{DR1 forest correlation from $2.8\times 10^8$ pixels. Left: measured $r_\perp ^2\xi _F$ in three radial-separation strips (points, pair-weight errors, collapsed over redshift with the pair weights) with the fitted table of Equation~\eqref {eq:xifit} (solid) and its base model without the correction (dotted), both averaged over the redshift bins with the same pair weights. Middle and right: the residual of each fit in units of the per-cell error, on the $(r_\perp ,r_\parallel )$ plane; the first three radial cells are outside the fit range}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces What the correction does. Left: the excess of the first radial bin over the two-parameter fit (points) and the fitted same-wavelength term $N(r_\perp )$ (line); it is flat at $\simeq 10^{-3}$ beyond $6\,h^{-1}{\rm  Mpc}$ and enters the mean field but not the kernel. Middle: the ratio of the new response kernel to the one used in the first measurement, over the part of the pair domain where the kernel is large, with contours of the Fisher-information density of the amplitude. Right: the kernel itself, $-r_\perp ^2\,\partial \xi _F/\partial r_\perp $, at two radial separations, published (dotted) against corrected (solid). Fisher-weighted, the kernel change raises the lensing amplitude by 10 per cent.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:xicorr}{{3}{6}{What the correction does. Left: the excess of the first radial bin over the two-parameter fit (points) and the fitted same-wavelength term $N(r_\perp )$ (line); it is flat at $\simeq 10^{-3}$ beyond $6\Mpch $ and enters the mean field but not the kernel. Middle: the ratio of the new response kernel to the one used in the first measurement, over the part of the pair domain where the kernel is large, with contours of the Fisher-information density of the amplitude. Right: the kernel itself, $-r_\perp ^2\,\partial \xi _F/\partial r_\perp $, at two radial separations, published (dotted) against corrected (solid). Fisher-weighted, the kernel change raises the lensing amplitude by 10 per cent}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Where the lensing information lives: the cumulative Fisher information of the amplitude versus $r_\perp $ and $r_\parallel $ on a scale-1 mock, per band and combined. Half of the information is inside $r_\perp =15\,h^{-1}{\rm  Mpc}$ and 80 per cent at $r_\parallel <5\,h^{-1}{\rm  Mpc}$.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:profile}{{4}{6}{Where the lensing information lives: the cumulative Fisher information of the amplitude versus $r_\perp $ and $r_\parallel $ on a scale-1 mock, per band and combined. Half of the information is inside $r_\perp =15\Mpch $ and 80 per cent at $r_\parallel <5\Mpch $}{figure.4}{}}
